{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Lets the Chatboard page (served by the local server) show notifications and open links in the browser.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"]
  },
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }, { "url": "mailto:*" }]
    }
  ]
}
